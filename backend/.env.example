# ============================================================
# 项目环境变量配置模板（.env.example）
# 使用方法：复制本文件为 .env 并填入你自己的配置
#   copy .env.example .env
# 注意：.env 包含敏感信息，已被 .gitignore 排除，请勿提交到 git
# ============================================================

# Django 密钥（生产环境务必更换为随机字符串）
DJANGO_SECRET_KEY=django-insecure-change-me-to-a-random-string
DJANGO_DEBUG=True

# PostgreSQL 数据库连接配置
DB_NAME=blog
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis 连接配置（缓存 + Celery 消息队列）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# 前端地址（CORS 白名单）
FRONTEND_URL=http://localhost:5173

# DeepSeek 大模型 API 配置（AI 创新点）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 向量模型 API 配置（创新点2 - 语义检索）
# 推荐：硅基流动 SiliconFlow 提供 bge-m3 等免费额度，OpenAI 兼容接口
# 申请地址：https://cloud.siliconflow.cn
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
